          "sourceSlideId": "2.08",
          "base": {
            "audioFile": "m2_2_08_base.mp3",
            "words": 64,
            "approxSeconds": 27,
            "lines": [
              "After collection, blood culture bottles should be sent to the microbiology laboratory immediately for prompt processing.",
              "The bottles must not be refrigerated, as low temperatures may inhibit the growth of microorganisms.",
              "If there is an unavoidable delay, the samples should be kept at room temperature until they are transported.",
              "Proper transport and storage are essential to maintain specimen integrity and ensure accurate culture results."
            ],
            "reveal": {
              "mode": "per_line",
              "note": "one cue per line, synced to the narration line beside it",
              "cues": [
