                  "lineIndex": 2
                },
                {
                  "order": 3,
                  "componentId": "slide_2_03_process",
                  "itemIndex": 2,
                  "lineIndex": 3
                },
                {
                  "order": 4,
                  "componentId": "slide_2_03_process",
                  "itemIndex": 3,
                  "lineIndex": 4
                },
                {
                  "order": 5,
