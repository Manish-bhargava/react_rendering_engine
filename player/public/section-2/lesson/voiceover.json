        {
          "slideId": "slide_2_09",
          "sourceSlideId": "2.09",
          "base": {
            "audioFile": "m2_2_09_base.mp3",
            "words": 82,
            "approxSeconds": 35,
            "lines": [
              "Interpreting blood culture results is important to distinguish true infection from contamination.",
              "A true pathogen is usually indicated when the same microorganism grows in multiple blood culture bottles and the findings are consistent with the patient's clinical condition.",
              "Possible contamination is suspected when a common skin organism grows in only one bottle, especially if the patient is clinically stable and shows no signs of systemic infection.",
              "Clinical correlation is essential to determine whether the result represents a true bloodstream infection or contamination."
            ],
            "reveal": {
              "mode": "per_line",
              "note": "one cue per line, synced to the narration line beside it",
              "cues": [
                {
                  "order": 1,
                  "componentId": "slide_2_09_comparison",
                  "itemIndex": 0,
                  "lineIndex": 1
                },
                {
                  "order": 2,
                  "componentId": "slide_2_09_comparison",
                  "itemIndex": 1,
                  "lineIndex": 2
                }
              ]
            }
          },
          "layers": [],
          "playback": {
            "autoplayBase": true,
            "sequence": [
              "base"
            ],
            "pauseBaseOnLayerOpen": null,
            "resumeBaseOnLayerClose": null,
