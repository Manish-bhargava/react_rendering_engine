        {
          "slideId": "slide_2_03",
          "sourceSlideId": "2.03",
          "base": {
            "audioFile": "m2_2_03_base.mp3",
            "words": 65,
            "approxSeconds": 28,
            "lines": [
              "The full collection procedure runs to nineteen steps, which group into five stages.",
              "Before you start - the order, the patient, the explanation.",
              "Prepare - hand hygiene, equipment, bottle tops, site.",
              "Antisepsis and access - tourniquet, skin prep, sterile gloves.",
              "Draw and inoculate - venipuncture, volume, bottles, mixing.",
              "And finish - labelling, dressing, sharps, documentation, transport.",
              "Click each stage to see the steps it contains."
            ],
            "reveal": {
              "mode": "per_line",
              "note": "one cue per line, synced to the narration line beside it",
              "cues": [
                {
                  "order": 1,
                  "componentId": "slide_2_03_process",
                  "itemIndex": 0,
                  "lineIndex": 1
                },
                {
                  "order": 2,
                  "componentId": "slide_2_03_process",
